/*
 * Generic 32-bit access used for generated AXI BRAM and AXI GPIO IOCTLs.
 * offset is relative to the peripheral base address and must be 4-byte
 * aligned. value contains the data to write or the value returned on read.
 */
struct $$DEVICE_NAME_L$$_mmio_access {
    __u32 offset;
    __u32 value;
};

