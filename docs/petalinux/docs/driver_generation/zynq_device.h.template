enum AxiStreamFifo_Register {
    ISR   = 0x00,   /* Interrupt Status Register. */
    IER   = 0x04,   /* Interrupt Enable Register. */
    TDFR  = 0x08,   /* Transmit Data FIFO Reset. */
    TDFV  = 0x0c,   /* Transmit Data FIFO Vacancy. */
    TDFD  = 0x10,   /* Transmit Data FIFO 32-bit write port. */
    TDFD4 = 0x1000, /* Transmit Data FIFO AXI4 write port. */
    TLR   = 0x14,   /* Transmit Length Register. */
    RDFR  = 0x18,   /* Receive Data FIFO Reset. */
    RDFO  = 0x1c,   /* Receive Data FIFO Occupancy. */
    RDFD  = 0x20,   /* Receive Data FIFO 32-bit read port. */
    RDFD4 = 0x1000, /* Receive Data FIFO AXI4 read port. */
    RLR   = 0x24,   /* Receive Length Register. */
    SRR   = 0x28,   /* AXI4-Stream Reset. */
    TDR   = 0x2c,   /* Transmit Destination Register. */
    RDR   = 0x30,   /* Receive Destination Register. */
    TID   = 0x34,   /* Transmit ID Register. */
    TUSER = 0x38,   /* Transmit USER Register. */
    RID   = 0x3c,   /* Receive ID Register. */
    RUSER = 0x40    /* Receive USER Register. */
};

enum AxiStreamFifo_ISREnum {
    ISR_RFPE  = 1U << 19,
    ISR_RFPF  = 1U << 20,
    ISR_TFPE  = 1U << 21,
    ISR_TFPF  = 1U << 22,
    ISR_RRC   = 1U << 23,
    ISR_TRC   = 1U << 24,
    ISR_TSE   = 1U << 25,
    ISR_RC    = 1U << 26,
    ISR_TC    = 1U << 27,
    ISR_TPOE  = 1U << 28,
    ISR_RPUE  = 1U << 29,
    ISR_RPORE = 1U << 30,
    ISR_RPURE = 1U << 31,
};

