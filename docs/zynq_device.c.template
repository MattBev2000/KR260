// IOCTL //
static long device_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
{    
    int i;
    int status = 0;
    struct $$DEVICE_NAME_L$$_dev *dev = file->private_data;

    switch (cmd) {
#ifdef HAS_DMA
    case $$DEVICE_NAME_U$$_ARM_DMA:
      {
        if(!dev->dma_allocated)
        {
            int i;
            dma_addr_t currHandle;
            for(i = 0; i < dev->num_dma_buffers; i++)
            {
   		printk("ALLOC COHERENT %d\n", dev->dma_buf_sizes[i]);
               	dev->dma_buffers[i] = dma_alloc_coherent(dev->dma_chan->device->dev,dev->dma_buf_sizes[i],&dev->dma_handles[i],GFP_KERNEL);
   		printk("ALLOCATED COHERENT %p\t%x\n", dev->dma_buffers[i], dev->dma_handles[i]);
            }
            dev->dma_allocated = 1;
        }
        return 0;
      }
      case $$DEVICE_NAME_U$$_START_DMA:
      {
//Start DMA if DMA buffer previusly allocated
        if(!dev->dma_allocated)
            return -1;
        for(i = 0; i < dev->num_dma_buffers; i++)
        {
            memset(dev->dma_buffers[i], 0, dev->dma_buf_sizes[i]);
        }
        dev->dma_cookie = dma_prep_buffer(dev, dev->dma_chan, dev->dma_handles, dev->dma_buf_sizes, dev->dma_sg, 
                                          dev->num_dma_buffers, DMA_DEV_TO_MEM);
        if (dma_submit_error(dev->dma_cookie) ) {
            printk(KERN_ERR "dma_prep_buffer error\n");
            return -EIO;
        }
        printk(KERN_INFO "Starting DMA transfers. num dma buffers %d\n", dev->num_dma_buffers);
        dma_start_transfer(dev->dma_chan, &dev->dma_cmp, dev->dma_cookie);
        dev->dma_started = 1;
        return 0;
      }
      case $$DEVICE_NAME_U$$_STOP_DMA:
      {
          int status = dma_async_is_tx_complete(dev->dma_chan, dev->dma_cookie,
                                                        NULL, NULL);
          if(status != DMA_COMPLETE)
           printk("DMA ENGINE NOT STOPPED!!!!!!\n");
          dmaengine_terminate_all(dev->dma_chan);
          dev->dma_started = 0;
          return 0;
      }
      case $$DEVICE_NAME_U$$_IS_DMA_RUNNING:
      {
          copy_to_user ((void __user *)arg, &dev->dma_started, sizeof(u32));    
          return 0;
      }
      case $$DEVICE_NAME_U$$_GET_DMA_BUFLEN:
      {
          copy_to_user ((void __user *)arg, &dev->dma_tot_size, sizeof(u32));   
          return 0;
      }
      case $$DEVICE_NAME_U$$_SET_DMA_BUFLEN:
      {
          u32 numDmaBuffers;
          u32 dmaBuflen;
          int i;
          copy_from_user (&dmaBuflen, (void __user *)arg, sizeof(u32)); 
          if(dmaBuflen <= 0 || dmaBuflen > MAX_DMA_BUFFERS * DMA_BUFSIZE)
              return -1;
          if(dev->dma_tot_size != dmaBuflen)
          {
              if(dev->dma_allocated > 0)
              {
                  for(i = 0; i < dev->num_dma_buffers; i++)
                  {
                      dma_free_coherent(dev->dma_chan->device->dev,dev->dma_buf_sizes[i],dev->dma_buffers[i],dev->dma_handles[i]);
                  }
                  dev->dma_allocated = 0;
              }
          }
          dev->num_dma_buffers = dmaBuflen / DMA_BUFSIZE;
          for(i = 0; i < dev->num_dma_buffers; i++)
              dev->dma_buf_sizes[i] = DMA_BUFSIZE;
          if(dmaBuflen % DMA_BUFSIZE)
          {
              dev->dma_buf_sizes[dev->num_dma_buffers] = dmaBuflen % DMA_BUFSIZE;
              dev->num_dma_buffers++;
              printk("LAST DMA SIZE: %d\n", dmaBuflen % DMA_BUFSIZE);
          }
          dev->dma_tot_size = dmaBuflen;
          printk("NUM DMA BUFFERS: %d\n", dev->num_dma_buffers);
          return 0;
      }
      case $$DEVICE_NAME_U$$_GET_DMA_DATA:
      {
          int i;
          if(!dev->dma_allocated)
              return -1;
          char *currPtr = (void __user *)arg;
          for(i = 0; i < dev->num_dma_buffers; i++)
          {
              printk("COPYING %d  %d\n", i,  dev->dma_buf_sizes[i]);
              copy_to_user ((void __user *)currPtr, dev->dma_buffers[i], dev->dma_buf_sizes[i]);
              currPtr += dev->dma_buf_sizes[i];
          }
          return 0;
      }
      
      
      case $$DEVICE_NAME_U$$_INIT_DMA_READ:
       {
          copy_from_user (&dev->dma_chunk_size, (void __user *)arg, sizeof(u32)); 
      	  dev->dma_chunk_idx = 0;
          return 0;
       }
       case $$DEVICE_NAME_U$$_GET_DMA_CHUNK:
       {
      	  int bufIdx, bufOffset, currSize, doneSize;
      	  char *currOutPtr = (void __user *)arg;
      	  char *currPtr;
      	  bufIdx = (dev->dma_chunk_idx * dev->dma_chunk_size)/DMA_BUFSIZE; //Dimension of all buffers except the last one is DMA_BUFSIZE
      	  if(bufIdx >= dev->num_dma_buffers)
      	      return -1;
      	  bufOffset = (dev->dma_chunk_idx * dev->dma_chunk_size)%DMA_BUFSIZE;
      	  doneSize = 0;
      	  while(1)
      	  {
       	      currPtr =  dev->dma_buffers[bufIdx] + bufOffset;
     	      currSize = dev->dma_buf_sizes[bufIdx] - bufOffset;
      	      if(doneSize + currSize >= dev->dma_chunk_size)
      	      {
      	      	  currSize = dev->dma_chunk_size - doneSize;
      	      	  copy_to_user ((void __user *)currOutPtr, currPtr, currSize);
      	      	  dev->dma_chunk_idx++;
      	      	  return dev->dma_chunk_size;
      	     }
      	     copy_to_user ((void __user *)currOutPtr, currPtr, currSize);
      	     currOutPtr += currSize;
     	     doneSize += currSize;
     	     bufIdx++;
     	     bufOffset = 0;
     	     if(bufIdx >= dev->num_dma_buffers) //Dma buffers finished
     	     {
      	 	printk("FINITI BUFFERS done: %d chunk size: %d\n", doneSize, dev->dma_chunk_size);
      	 	return doneSize;
      	      }
      	    }
      	    return 0;
       }
#endif //HAS_DMA      
      
      
    $$MAP_IOCTL$$
 
 #ifdef HAS_FIFO_INTERRUPT
 
    case $$DEVICE_NAME_U$$_FIFO_FLUSH:
	fifoFlush(dev);
    case $$DEVICE_NAME_U$$_START_READ:
	  dev->started = 1;
        return 0;
    case $$DEVICE_NAME_U$$_STOP_READ:
	  dev->started = 0;
        return 0;

 
 #endif
 
    default:
        return -EAGAIN;
        break;
    }
    return status;
}


