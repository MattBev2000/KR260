#ifdef HAS_DMA

static dma_cookie_t dma_prep_buffer(
    struct $$DEVICE_NAME_L$$_dev *dev,
    struct dma_chan *chan,
    dma_addr_t *handles,
    size_t *lens,
    struct scatterlist *sg,
    u32 num_dma_buffers,
    enum dma_transfer_direction dir
);

static void dma_start_transfer(
    struct dma_chan *chan,
    struct completion *cmp,
    dma_cookie_t cookie
);

static void dma_sync_callback(void *arg)
{
    int status;
    dma_cookie_t lastCookie;
    struct $$DEVICE_NAME_L$$_dev *dev;

    dev = (struct $$DEVICE_NAME_L$$_dev *)arg;

    printk(
        KERN_DEBUG
        "DMA SYNC CALLBACK %u\n",
        dev->num_dma_buffers
    );

    status = dma_async_is_tx_complete(
        dev->dma_chan,
        dev->dma_cookie,
        &lastCookie,
        NULL
    );

    if (status != DMA_COMPLETE) {
        printk(
            KERN_ERR
            "DMA callback status: %s\n",
            status == DMA_ERROR ? "error" : "in progress"
        );
    }

    if (lastCookie != dev->dma_cookie) {
        printk(
            KERN_ERR
            "DMA not terminated for this cookie: %d %d\n",
            lastCookie,
            dev->dma_cookie
        );

        dmaengine_terminate_all(dev->dma_chan);
    }

    dev->dma_started = 0;

    printk(KERN_DEBUG "DMA TERMINATED\n");
}

static dma_cookie_t dma_prep_buffer(
    struct $$DEVICE_NAME_L$$_dev *dev,
    struct dma_chan *chan,
    dma_addr_t *handles,
    size_t *lens,
    struct scatterlist *sg,
    u32 num_dma_buffers,
    enum dma_transfer_direction dir
)
{
    int i;
    enum dma_ctrl_flags flags;
    struct dma_async_tx_descriptor *chan_desc;
    dma_cookie_t cookie;

    flags = DMA_CTRL_ACK;

    set_user_nice(current, 10);

    sg_init_table(sg, num_dma_buffers);

    for (i = 0; i < num_dma_buffers; i++) {
        sg_dma_address(&sg[i]) = handles[i];
        sg_dma_len(&sg[i]) = lens[i];
    }

    chan_desc = dmaengine_prep_slave_sg(
        chan,
        sg,
        num_dma_buffers,
        dir,
        flags
    );

    if (!chan_desc) {
        printk(
            KERN_ERR
            "dmaengine_prep_slave_sg error\n"
        );

        return -EBUSY;
    }

    chan_desc->callback = dma_sync_callback;
    chan_desc->callback_param = dev;

    cookie = dmaengine_submit(chan_desc);

    printk(
        KERN_DEBUG
        "Submitted DMA cookie: %d\n",
        cookie
    );

    return cookie;
}

static void dma_start_transfer(
    struct dma_chan *chan,
    struct completion *cmp,
    dma_cookie_t cookie
)
{
    init_completion(cmp);
    dma_async_issue_pending(chan);
}

