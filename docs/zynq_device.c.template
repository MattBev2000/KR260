static int device_open(
    struct inode *inode,
    struct file *file
)
{
    struct $$DEVICE_NAME_L$$_dev *privateInfo;

    if (!file->private_data) {
        privateInfo = container_of(
            inode->i_cdev,
            struct $$DEVICE_NAME_L$$_dev,
            cdev
        );

        printk(
            KERN_DEBUG
            "OPEN: privateInfo = %p\n",
            privateInfo
        );

        file->private_data = privateInfo;

        privateInfo->busy = 0;
        privateInfo->dma_started = 0;
    }

    privateInfo =
        (struct $$DEVICE_NAME_L$$_dev *)file->private_data;

    if (!privateInfo)
        return -EFAULT;

    if (privateInfo->busy)
        return -EBUSY;

    privateInfo->busy++;
    privateInfo->started = 0;

    return capable(CAP_SYS_RAWIO) ? 0 : -EPERM;
}

static int device_release(
    struct inode *inode,
    struct file *file
)
{
    struct $$DEVICE_NAME_L$$_dev *dev;

    dev = file->private_data;

    if (!dev)
        return -EFAULT;

    if (--dev->busy == 0)
        printk(KERN_DEBUG "CLOSE\n");

    return 0;
}


#ifdef HAS_FIFO_INTERRUPT

static ssize_t device_read(
    struct file *filp,
    char *buffer,
    size_t length,
    loff_t *offset
)
{
    u32 i;
    u32 occ;
    u32 data;
    u32 words_to_read;
    u32 __user *user_buffer;

    volatile struct $$DEVICE_NAME_L$$_dev *dev;

    dev = &staticPrivateInfo;
    user_buffer = (u32 __user *)buffer;

    if (!dev->started)
        return 0;

    occ = readFifo(dev->iomap_stream_fifo, RDFO);

    words_to_read = min_t(
        u32,
        (u32)(length / sizeof(u32)),
        occ
    );

    for (i = 0; i < words_to_read; i++) {
        data = readFifo(
            dev->iomap_stream_fifo,
            RDFD
        );

        if (put_user(data, user_buffer++))
            return -EFAULT;
    }

    return i * sizeof(u32);
}

static void fifoFlush(
    struct $$DEVICE_NAME_L$$_dev *dev
)
{
    u32 occ;
    u32 i;

    occ = readFifo(
        dev->iomap_stream_fifo,
        RDFO
    );

    for (i = 0; i < occ; i++)
        readFifo(
            dev->iomap_stream_fifo,
            RDFD
        );
}

