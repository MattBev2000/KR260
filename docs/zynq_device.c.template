static ssize_t device_read(struct file *filp, char *buffer, size_t length,
                           loff_t *offset)
{    
    u32 i = 0;
 volatile   struct $$DEVICE_NAME_L$$_dev *dev = &staticPrivateInfo;
    u32 occ, d;
    u32 *b32 = (u32 *)buffer;    

    if(!dev->started) return 0;        
    occ = readFifo(dev->iomap_stream_fifo,RDFO);
    //printk("READ  OCC: %d\n", occ);
    for (i = 0; i < min(length/4, occ); i++)
    {
        d = readFifo(dev->iomap_stream_fifo,RDFD);
	put_user(d, b32++);
    }
    return i * sizeof(u32);
}

