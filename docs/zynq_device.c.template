        cdev_del(
            &staticPrivateInfo.cdev
        );

        unregister_chrdev_region(
            newDev,
            1
        );

        return err;
    }

    printk(
        KERN_NOTICE
        "Create device node with: "
        "mknod /dev/%s c %d 0\n",
        DEVICE_NAME,
        id_major
    );

    return 0;
}

static void __exit $$DEVICE_NAME_L$$_exit(void)
{
    dev_t devno;

    printk(
        KERN_INFO
        "Exiting AXI module\n"
    );

    platform_driver_unregister(
        &$$DEVICE_NAME_L$$_driver
    );

    devno = MKDEV(id_major, 0);

    unregister_chrdev_region(
        devno,
        1
    );
}

module_init($$DEVICE_NAME_L$$_init);
module_exit($$DEVICE_NAME_L$$_exit);

