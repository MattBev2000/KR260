#ifdef HAS_FIFO_INTERRUPT

static void fifoFlush(struct $$DEVICE_NAME_L$$_dev *dev)
{
    volatile u32 occ, d, i;
    occ = readFifo(dev->iomap_stream_fifo,RDFO);
    for (i = 0; i < occ; i++)
    {
        d = readFifo(dev->iomap_stream_fifo,RDFD);
    }
}

