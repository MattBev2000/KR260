static long device_ioctl(
    struct file *file,
    unsigned int cmd,
    unsigned long arg
)
{
    int status;
    struct $$DEVICE_NAME_L$$_dev *dev;

    status = 0;
    dev = file->private_data;

    if (!dev)
        return -EFAULT;

    switch (cmd) {

#ifdef HAS_DMA

    case $$DEVICE_NAME_U$$_ARM_DMA:
    {
        int i;

        if (!dev->dma_allocated) {
            for (i = 0; i < dev->num_dma_buffers; i++) {
                dev->dma_buffers[i] = dma_alloc_coherent(
                    dev->dma_chan->device->dev,
                    dev->dma_buf_sizes[i],
                    &dev->dma_handles[i],
                    GFP_KERNEL
                );

                if (!dev->dma_buffers[i])
                    return -ENOMEM;
            }

            dev->dma_allocated = 1;
        }

        return 0;
    }

    case $$DEVICE_NAME_U$$_START_DMA:
    {
        int i;

        if (!dev->dma_allocated)
            return -EINVAL;

        for (i = 0; i < dev->num_dma_buffers; i++) {
            memset(
                dev->dma_buffers[i],
                0,
                dev->dma_buf_sizes[i]
            );
        }

        dev->dma_cookie = dma_prep_buffer(
            dev,
            dev->dma_chan,
            dev->dma_handles,
            dev->dma_buf_sizes,
            dev->dma_sg,
            dev->num_dma_buffers,
            DMA_DEV_TO_MEM
        );

        if (dma_submit_error(dev->dma_cookie)) {
            printk(
                KERN_ERR
                "dma_prep_buffer error\n"
            );

            return -EIO;
        }

        printk(
            KERN_INFO
            "Starting DMA transfers, buffers: %u\n",
            dev->num_dma_buffers
        );

        dma_start_transfer(
            dev->dma_chan,
            &dev->dma_cmp,
            dev->dma_cookie
        );

        dev->dma_started = 1;

        return 0;
    }

    case $$DEVICE_NAME_U$$_STOP_DMA:
    {
        int dma_status;

        dma_status = dma_async_is_tx_complete(
            dev->dma_chan,
            dev->dma_cookie,
            NULL,
            NULL
        );

        if (dma_status != DMA_COMPLETE)
            printk(
                KERN_WARNING
                "DMA engine has not completed\n"
            );

        dmaengine_terminate_all(dev->dma_chan);

        dev->dma_started = 0;

        return 0;
    }

    case $$DEVICE_NAME_U$$_IS_DMA_RUNNING:
        if (copy_to_user(
            (void __user *)arg,
            &dev->dma_started,
            sizeof(u32)
        ))
            return -EFAULT;

        return 0;

    case $$DEVICE_NAME_U$$_GET_DMA_BUFLEN:
        if (copy_to_user(
            (void __user *)arg,
            &dev->dma_tot_size,
            sizeof(u32)
        ))
            return -EFAULT;

        return 0;

    case $$DEVICE_NAME_U$$_SET_DMA_BUFLEN:
    {
        u32 dmaBuflen;
        int i;

        if (copy_from_user(
            &dmaBuflen,
            (void __user *)arg,
            sizeof(u32)
        ))
            return -EFAULT;

        if (!dmaBuflen ||
            dmaBuflen > MAX_DMA_BUFFERS * DMA_BUFSIZE)
            return -EINVAL;

        if (dev->dma_tot_size != dmaBuflen &&
            dev->dma_allocated) {

            for (i = 0; i < dev->num_dma_buffers; i++) {
                dma_free_coherent(
                    dev->dma_chan->device->dev,
                    dev->dma_buf_sizes[i],
                    dev->dma_buffers[i],
                    dev->dma_handles[i]
                );
            }

            dev->dma_allocated = 0;
        }

        dev->num_dma_buffers =
            dmaBuflen / DMA_BUFSIZE;

        for (i = 0; i < dev->num_dma_buffers; i++)
            dev->dma_buf_sizes[i] = DMA_BUFSIZE;

        if (dmaBuflen % DMA_BUFSIZE) {
            dev->dma_buf_sizes[
                dev->num_dma_buffers
            ] = dmaBuflen % DMA_BUFSIZE;

            dev->num_dma_buffers++;
        }

        dev->dma_tot_size = dmaBuflen;

        return 0;
    }

    case $$DEVICE_NAME_U$$_GET_DMA_DATA:
    {
        int i;
        char __user *currPtr;

        if (!dev->dma_allocated)
            return -EINVAL;

        currPtr = (char __user *)arg;

        for (i = 0; i < dev->num_dma_buffers; i++) {
            if (copy_to_user(
                currPtr,
                dev->dma_buffers[i],
                dev->dma_buf_sizes[i]
            ))
                return -EFAULT;

            currPtr += dev->dma_buf_sizes[i];
        }

        return 0;
    }

    case $$DEVICE_NAME_U$$_INIT_DMA_READ:
        if (copy_from_user(
            &dev->dma_chunk_size,
            (void __user *)arg,
            sizeof(u32)
        ))
            return -EFAULT;

        dev->dma_chunk_idx = 0;

        return 0;

    case $$DEVICE_NAME_U$$_GET_DMA_CHUNK:
    {
        int bufIdx;
        int bufOffset;
        int currSize;
        int doneSize;

        char __user *currOutPtr;
        char *currPtr;

        currOutPtr = (char __user *)arg;

        bufIdx =
            (dev->dma_chunk_idx *
             dev->dma_chunk_size) /
            DMA_BUFSIZE;

        if (bufIdx >= dev->num_dma_buffers)
            return -EINVAL;

        bufOffset =
            (dev->dma_chunk_idx *
             dev->dma_chunk_size) %
            DMA_BUFSIZE;

        doneSize = 0;

        while (1) {
            currPtr =
                dev->dma_buffers[bufIdx] +
                bufOffset;

            currSize =
                dev->dma_buf_sizes[bufIdx] -
                bufOffset;

            if (doneSize + currSize >=
                dev->dma_chunk_size) {

                currSize =
                    dev->dma_chunk_size -
                    doneSize;

                if (copy_to_user(
                    currOutPtr,
                    currPtr,
                    currSize
                ))
                    return -EFAULT;

                dev->dma_chunk_idx++;

                return dev->dma_chunk_size;
            }

            if (copy_to_user(
                currOutPtr,
                currPtr,
                currSize
            ))
                return -EFAULT;

            currOutPtr += currSize;
            doneSize += currSize;
            bufIdx++;
            bufOffset = 0;

            if (bufIdx >= dev->num_dma_buffers)
                return doneSize;
        }
    }

#endif

    $$MAP_IOCTL$$

#ifdef HAS_FIFO_INTERRUPT

    case $$DEVICE_NAME_U$$_FIFO_FLUSH:
        fifoFlush(dev);
        return 0;

    case $$DEVICE_NAME_U$$_START_READ:
        dev->started = 1;
        return 0;

    case $$DEVICE_NAME_U$$_STOP_READ:
        dev->started = 0;
        return 0;

#endif

    default:
        return -EAGAIN;
    }

    return status;
}


